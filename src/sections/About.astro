---
import Section from '../components/Section.astro';
---

<Section id="about" eyebrow="Why BananaByte" heading="A local Orlando partner focused on clean execution and lasting results.">
  <div class="grid gap-10 md:grid-cols-[1.3fr_1fr]">
    <div class="space-y-4 text-white/80">
      <p>
        BananaByte helps small and midsize businesses modernize operations through pragmatic IT and web delivery.
      </p>
      <p>
        We prioritize outcomes over buzzwords: stable systems, faster websites, and clear communication from kickoff to support.
      </p>
    </div>
    <ul class="grid gap-3 font-mono text-xs uppercase tracking-[0.2em] text-black md:content-start">
      <li class="rounded border border-banana-gold/40 bg-banana-bright px-4 py-3">Local Orlando Support</li>
      <li class="rounded border border-banana-gold/40 bg-banana-bright px-4 py-3">Fast Turnaround</li>
      <li class="rounded border border-banana-gold/40 bg-banana-bright px-4 py-3">Modern Stack</li>
      <li class="rounded border border-banana-gold/40 bg-banana-bright px-4 py-3">No Vendor Lock-In</li>
    </ul>
  </div>
</Section>
